generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model UserProfile {
  id            String   @id // Clerk user ID
  email         String   @unique
  displayName   String?
  currency      String   @default("INR")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  salaries      Salary[]
  transactions  Transaction[]
  budgets       Budget[]
  categories    Category[]
  @@map("user_profiles")
}
model Category {
  id        String   @id @default(cuid())
  userId    String
  name      String
  kind      String   // income | expense
  color     String   @default("#8B8BF5")
  icon      String   @default("circle")
  createdAt DateTime @default(now())
  user      UserProfile @relation(fields:[userId], references:[id], onDelete:Cascade)
  transactions Transaction[]
  @@unique([userId,name,kind])
  @@index([userId,kind])
  @@map("categories")
}
model Salary {
  id          String   @id @default(cuid())
  userId      String
  title       String
  amount      Decimal  @db.Decimal(14,2)
  payDate     DateTime
  monthKey    String
  notes       String?
  createdAt   DateTime @default(now())
  user        UserProfile @relation(fields:[userId], references:[id], onDelete:Cascade)
  @@index([userId,monthKey])
  @@map("salaries")
}
model Transaction {
  id          String   @id @default(cuid())
  userId      String
  categoryId  String?
  title       String
  amount      Decimal  @db.Decimal(14,2)
  kind        String   // income | expense
  date        DateTime
  monthKey    String
  paymentMode String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        UserProfile @relation(fields:[userId], references:[id], onDelete:Cascade)
  category    Category? @relation(fields:[categoryId], references:[id], onDelete:SetNull)
  @@index([userId,date])
  @@index([userId,monthKey,kind])
  @@map("transactions")
}
model Budget {
  id          String   @id @default(cuid())
  userId      String
  categoryId  String?
  name        String
  limitAmount Decimal  @db.Decimal(14,2)
  monthKey    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        UserProfile @relation(fields:[userId], references:[id], onDelete:Cascade)
  @@unique([userId,name,monthKey])
  @@index([userId,monthKey])
  @@map("budgets")
}
